# NationStates credentials
NATION_NAME=YourNationName
NATION_PASSWORD=YourPassword
CONTACT_EMAIL=youremail@example.com

# LM Studio (OpenAI-compatible local server)
LMSTUDIO_URL=http://localhost:1234
LLM_MODEL=local-model  # LM Studio usa el modelo que tengas cargado
EMBEDDING_MODEL=all-MiniLM-L6-v2  # sentence-transformers, local

# Loop configuration (in minutes)
CHECK_INTERVAL=30

# Optional: telegram bot for notifications
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=
